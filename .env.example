# Public key used by clients to call LiteLLM on localhost:4000.
PUBLIC_LITELLM_KEY=sk-public-change-me

# Private LiteLLM-to-NeMo key. Do not expose it to clients.
NEMO_SERVICE_API_KEY=sk-nemo-change-me

# LiteLLM sends allowed requests to this application model.
UPSTREAM_MODEL=openai/gpt-4o-mini

# NeMo uses this smaller model only for self-check input/output decisions.
NEMO_GUARD_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_api_key_here
