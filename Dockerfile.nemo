FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# annoy is a native NeMo dependency. It is compiled inside Linux so Windows
# does not need Microsoft Visual C++ Build Tools.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /service

COPY requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -r requirements.txt

COPY nemo_service ./nemo_service
COPY config ./config

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /service
USER appuser

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "nemo_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
